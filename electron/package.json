{
  "name": "navi-radio",
  "version": "1.0.0",
  "description": "navi-radio \u2014 xvoidsx internet radio + local music",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.xvoidsx.navi-radio",
    "productName": "navi-radio",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "../icons",
      "maintainer": "xvoidsx <hello@xvoidsx.org>"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      {
        "from": "..",
        "to": ".",
        "filter": [
          "index.html"
        ]
      },
      {
        "from": "../icons",
        "to": "icons"
      }
    ],
    "afterPack": "./scripts/afterPack.js"
  },
  "keywords": [],
  "author": {
    "name": "xvoidsx",
    "email": "hello@xvoidsx.org"
  },
  "license": "ISC",
  "homepage": "https://xvoidsx.org"
}